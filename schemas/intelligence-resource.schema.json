{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huffmanmainnode.github.io/Open-Intelligence-Fabric/schemas/intelligence-resource.schema.json",
  "title": "Open Intelligence Resource",
  "description": "Interoperable descriptive contract for a discoverable OI resource. A manifest does not grant permission to invoke the resource.",
  "type": "object",
  "required": ["id", "name", "resource_type", "publisher", "version", "capabilities"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._:/-]*$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "resource_type": {"type": "string", "enum": ["model", "agent", "tool", "dataset", "skill", "service", "human_expertise", "compute"]},
    "publisher": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri"}},
      "additionalProperties": true
    },
    "version": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string"}},
        "additionalProperties": true
      }
    },
    "interfaces": {"type": "array", "items": {"type": "object"}},
    "inputs": {"type": "array", "items": {"type": "object"}},
    "outputs": {"type": "array", "items": {"type": "object"}},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object"},
    "verification": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "license": {"type": "string"}
  },
  "additionalProperties": true
}
